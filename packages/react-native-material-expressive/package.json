{
  "name": "react-native-material-expressive",
  "version": "0.0.0",
  "description": "Material 3 Expressive components for React Native, fidelity-verified against Jetpack Compose Material3 1.5.0.",
  "license": "MIT",
  "author": "Nasyx Rakeeb",
  "homepage": "https://github.com/nasyx-rakeeb/react-native-material-expressive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nasyx-rakeeb/react-native-material-expressive.git",
    "directory": "packages/react-native-material-expressive"
  },
  "bugs": {
    "url": "https://github.com/nasyx-rakeeb/react-native-material-expressive/issues"
  },
  "keywords": [
    "react-native",
    "material-design",
    "material-3",
    "material-3-expressive",
    "m3",
    "m3e",
    "ui",
    "components",
    "expo"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "!android/build",
    "!android/.gradle",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bob build",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "prepack": "bob build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.7.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "0.44.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "typescript": "6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "M3EDynamicColorSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.nasyxrakeeb.m3e"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|@material|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0"
  }
}
