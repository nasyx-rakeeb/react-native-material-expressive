{
  "name": "react-native-material-expressive-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for react-native-material-expressive",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && eslint tools && node tools/motion-kind/check.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scenes:build": "node tools/scenes/generate-typography.mjs && node tools/scenes/build.mjs",
    "scenes:check": "node tools/scenes/generate-typography.mjs --check && node tools/scenes/build.mjs --check",
    "pixel:build": "bash tools/pixel/build-harnesses.sh",
    "pixel:freeze": "bash tools/pixel/freeze-profile.sh",
    "pixel:run": "node tools/pixel/run.mjs",
    "pixel:render": "node tools/pixel/render.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
